# ==============================================================================
# AEGIS-IIOT — Adaptive Cyber Defense System Environment Configuration
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
PORT=5000
SECRET_KEY=generate_a_secure_random_secret_key_here
DATABASE_URL=sqlite:///database/database.db
FRONTEND_URL=https://aegis-iiot-frontend.vercel.app

# Email SMTP Notification Gateway
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=soc-alerts@your-domain.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_FROM_EMAIL=soc-alerts@your-domain.com

# Slack & Microsoft Teams Webhook Integration
SLACK_WEBHOOK_URL=https://your-slack-or-teams-webhook-url-here

# Twilio SMS Critical Dispatch Integration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199
ALERT_PHONE_NUMBER=+18005550100

# AI SOC Copilot & Explainability Provider
AI_PROVIDER=internal
AI_API_KEY=optional_gemini_or_openai_api_key
AI_MODEL=aegis-soc-intelligence-v1
